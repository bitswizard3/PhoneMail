# ============================================
# AlphaStack PhoneMail - Environment Variables
# ============================================

# Database
POSTGRES_USER=phonemail
POSTGRES_PASSWORD=phonemail_secret_2026
POSTGRES_DB=phonemail_db
DATABASE_URL=postgresql://phonemail:phonemail_secret_2026@postgres:5432/phonemail_db

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=alphastack-phonemail-jwt-secret-key-2026
JWT_EXPIRES_IN=7d

# Twilio (Free Trial)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# SMTP
SMTP_DOMAIN=phonemail.local
SMTP_PORT=25

# Backend
BACKEND_PORT=4000
NODE_ENV=development

# Web Client
VITE_API_URL=http://localhost:4000/api
